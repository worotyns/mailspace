# Copy to .env for Docker Compose; replace the domain and provider endpoints.
# The native binary does not load this file automatically.
# Full meanings/defaults: docs/CONFIGURATION.md (also linked from README).
# Compose fixes MAILSPACE_MODE=personal (authenticated mode; team sharing is not implemented)
# and MAILSPACE_DB=/app/data/mailspace.db inside the persistent data volume.
# Setting MODE or DB here does not override those Compose literals.
MAILSPACE_ORIGIN=https://mail.example.com
MAILSPACE_MAIL_ENDPOINTS=imap.example.com:993,smtp.example.com:465
# For an explicitly approved private mail server, use exact host:port pairs:
MAILSPACE_PRIVATE_MAIL_ENDPOINTS=
# Optional public CA PEM path INSIDE the container; mount it read-only separately.
MAILSPACE_MAIL_CA_FILE=
# Keep this stable. Changing it selects a different installation/database.
MAILSPACE_DATA_VOLUME=mailspace_mailspace-data
# Native binary defaults: personal mode, localhost:8080, data/mailspace.db.
# MAILSPACE_CREDENTIAL_KEYS defaults beside the database in credential-keys/.
# Synthetic local preview: make dev-sandbox (same product UI, isolated providers).
# MAILSPACE_INSECURE_HTTP=1 is allowed only with a loopback HTTP origin (native dev).

# Optional JEV classifier. Blank PROVIDER means no classifier worker/client.
# After configuring the provider, each user enables Manual/Review/Auto in Space automation.
# OpenRouter Jev: PROVIDER=openrouter, MODEL=typesafe/jev-1.13 (Decisions API).
# Ordinary OpenRouter models use the separate strict JSON-schema chat adapter.
MAILSPACE_JEV_PROVIDER=
MAILSPACE_JEV_MODEL=
# Choose API_TOKEN OR KEY_FILE, never both. Keep actual tokens only in ignored .env.
MAILSPACE_JEV_API_TOKEN=
# Example file path: /app/data/openrouter-api-key (app-owned, mode 0600).
MAILSPACE_JEV_KEY_FILE=
# Used only with PROVIDER=local, e.g. http://127.0.0.1:11434/v1/chat/completions.
# Plain HTTP is allowed only for numeric loopback addresses; other endpoints need HTTPS.
MAILSPACE_JEV_ENDPOINT=

# Optional continuous SQLite replication. Base compose never starts Litestream.
# To enable: set REPLICA_URL and use -f compose.yaml -f compose.backup.yaml.
# Local: file:///backups/mailspace (same-host only); off-host: s3://your-bucket/mailspace/db.
LITESTREAM_REPLICA_URL=
MAILSPACE_BACKUP_VOLUME=mailspace_mailspace-replicas
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
